# Resend API key — used by the contact form to send email notifications
# Get yours at https://resend.com/api-keys
RESEND_API=re_xxxxxxxxxxxx

# Resend sender address — must be a verified domain in your Resend account
# Default: "Portfolio Contact <onboarding@resend.dev>" (Resend testing domain)
# Production: "Portfolio Contact <contacto@dvillagrans.dev>"
RESEND_FROM=Portfolio Contact <contacto@tudominio.dev>

# Destination email for contact form submissions
# Default: dvillagrans11@gmail.com
CONTACT_EMAIL=tu-email@gmail.com

# DeepSeek API key — powers the AI chat assistant on the portfolio
# Get yours at https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Vercel Analytics (auto-injected by Vercel in production)
# No key needed — works automatically when deployed on Vercel
